# ==============================================================================
# EPharmacy System - Master .gitignore
# Covers Flutter Mobile Frontend + Spring Boot Backend + MySQL + IDEs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 2. General IDEs & Editors
# ------------------------------------------------------------------------------
.vscode/
*.code-workspace
.history/
*.sublime-project
*.sublime-workspace

# IntelliJ IDEA / Android Studio
.idea/
*.iws
*.ipr
*.iml

# ------------------------------------------------------------------------------
# 3. Environment, Secrets & Local Overrides
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.key
*.keystore
*.jks
*.p12
application-local.properties
*application-local.properties

# ------------------------------------------------------------------------------
# 4. Logs & Temp Files
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*.swo
*~
.gemini/

# ------------------------------------------------------------------------------
# 5. Backend (Java / Spring Boot 3 / Maven)
# ------------------------------------------------------------------------------
target/
backend/target/
*.class

# Maven wrapper jar (can be downloaded by mvnw)
.mvn/wrapper/maven-wrapper.jar
backend/.mvn/wrapper/maven-wrapper.jar

# Spring Tool Suite (STS) & Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
backend/.apt_generated
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings/
backend/.springBeans
backend/.sts4-cache

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/
backend/nbproject/private/
backend/nbbuild/
backend/dist/
backend/nbdist/
backend/.nb-gradle/

# Uploaded Prescription Images (keep folder via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# ------------------------------------------------------------------------------
# 6. Frontend (Flutter / Dart / Web / Android / iOS / Desktop)
# ------------------------------------------------------------------------------
# Flutter / Dart tooling & builds
.dart_tool/
frontend/.dart_tool/
.flutter-plugins
frontend/.flutter-plugins
.flutter-plugins-dependencies
frontend/.flutter-plugins-dependencies
.pub-cache/
frontend/.pub-cache/
.pub/
frontend/.pub/
build/
frontend/build/
coverage/
frontend/coverage/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Android
android/local.properties
frontend/android/local.properties
android/.gradle/
frontend/android/.gradle/
android/app/debug/
frontend/android/app/debug/
android/app/profile/
frontend/android/app/profile/
android/app/release/
frontend/android/app/release/

# iOS
frontend/ios/Flutter/.last_build_id
frontend/ios/Flutter/Flutter.framework
frontend/ios/Flutter/Flutter.podspec
frontend/ios/Flutter/Generated.xcconfig
frontend/ios/Flutter/app.framework
frontend/ios/.symlinks/
frontend/ios/Pods/
frontend/ios/.last_build_id
ios/.symlinks/
ios/Pods/

# Desktop / Web Ephemerals
frontend/windows/flutter/ephemeral/
frontend/linux/flutter/ephemeral/
frontend/macos/Flutter/ephemeral/
